# ==============================================================================
# Legacy Refactor Guard - Environment Configuration Template
# Copy this file to .env and adjust values as needed.
# ==============================================================================

# LLM Provider: "mock" (default for safe local development) or "nebius"
LLM_PROVIDER=mock

# Nebius Token Factory API Configuration
# (Required only when LLM_PROVIDER is set to "nebius")
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# Safety & Execution Settings
TEST_TIMEOUT_SECONDS=10
